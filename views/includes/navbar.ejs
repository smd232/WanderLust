<header class="site-nav">
    <div class="nav-inner">

        <div class="nav-left">
            <a href="/" class="nav-link-item">Home</a>
            <a href="/listings" class="nav-link-item">Listings</a>
            <a href="/listings/new" class="nav-link-item">Add your Listing</a>
        </div>

        <a href="/" class="nav-logo">
            <i class="fa-solid fa-mountain"></i>
            WanderLust
        </a>

        <div class="nav-right">
            <% if (!currUser) { %>
                <a href="/login" class="nav-login"><i class="fa-regular fa-user"></i> Login</a>
                <a href="/signup" class="nav-signup">Sign Up</a>
            <% } else { %>
                <a href="/logout" class="nav-signup">Logout</a>
            <% } %>
        </div>

    </div>
</header>

<script>
    document.querySelectorAll(".nav-link-item").forEach((a) => {
        if (a.getAttribute("href") === location.pathname) a.classList.add("active");
    });
</script>