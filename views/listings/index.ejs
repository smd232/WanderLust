<% layout("layout/boilerplate") %>
    <% let safeQuery=typeof query !=='undefined' ? query : '' ; let safeCategory=typeof category !=='undefined' ?
        category : '' ;%>

<div class="container">
<div class="section-head">
    <div>
        <p class="eyebrow">Explore</p>
        <h2>All Listings</h2>
        <p class="sub">Browse every stay, or pick a category below.</p>
    </div>
</div>

        <div id="filters">
            <a href="/listings" class="filter-link">
                <div class="filter <%= safeCategory === '' ? 'active' : '' %>">
                    <i class="fa-solid fa-layer-group"></i>
                    <p>All</p>
                </div>
            </a>
            <a href="/listings?category=rooms" class="filter-link">
                <div class="filter <%= safeCategory === 'rooms' ? 'active' : '' %>">
                        <i class="fa-solid fa-bed"></i>
                        <p>Rooms</p>
                    </div>
                </a>
            </a>
            <a href="/listings?category=iconic-cities" class="filter-link">
                <div class="filter <%= safeCategory === 'iconic-cities' ? 'active' : '' %>">
                    <i class="fa-solid fa-mountain-city"></i>
                    <p>Iconic cities</p>
                </div>
            </a>
            <a href="/listings?category=camping" class="filter-link">
                <div class="filter <%= safeCategory === 'camping' ? 'active' : '' %>">
                    <i class="fa-solid fa-tents"></i>
                    <p>Camping</p>
                </div>
            </a>
            <a href="/listings?category=mountains" class="filter-link">
                <div class="filter <%= safeCategory === 'mountains' ? 'active' : '' %>">
                    <i class="fa-solid fa-mountain"></i>
                    <p>Mountains</p>
                </div>
            </a>
            <a href="/listings?category=beach" class="filter-link">
                <div class="filter <%= safeCategory === 'beach' ? 'active' : '' %>">
                    <i class="fa-solid fa-umbrella-beach"></i>
                    <p>Beach</p>
                </div>
            </a>
            <a href="/listings?category=pools" class="filter-link">
                <div class="filter <%= safeCategory === 'pools' ? 'active' : '' %>">
                    <i class="fa-solid fa-person-swimming"></i>
                    <p>Pools</p>
                </div>
            </a>
            <a href="/listings?category=farms" class="filter-link">
                <div class="filter <%= safeCategory === 'farms' ? 'active' : '' %>">
                    <i class="fa-solid fa-cow"></i>
                    <p>Farms</p>
                </div>
            </a>
            <a href="/listings?category=arctic" class="filter-link">
                <div class="filter <%= safeCategory === 'arctic' ? 'active' : '' %>">
                    <i class="fa-solid fa-snowflake"></i>
                    <p>Arctic</p>
                </div>
            </a>
            <a href="/listings?category=ferry" class="filter-link">
                <div class="filter <%= safeCategory === 'ferry' ? 'active' : '' %>">
                    <i class="fa-solid fa-ferry"></i>
                    <p>Ferry</p>
                </div>
            </a>
            <a href="/listings?category=domes" class="filter-link">
                <div class="filter <%= safeCategory === 'domes' ? 'active' : '' %>">
                    <i class="fa-solid fa-landmark-dome"></i>
                    <p>Domes</p>
                </div>
            </a>
            <a href="/listings?category=igloos" class="filter-link">
                <div class="filter <%= safeCategory === 'igloos' ? 'active' : '' %>">
                    <i class="fa-solid fa-igloo"></i>
                    <p>Igloos</p>
                </div>
            </a>

            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
                </div>
            </div>

        </div>


        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mb-3">
    <% if (allListings.length === 0) { %>
        <p>No results found for "<%= safeQuery %>"</p>
    <% } else { %>
        <% for (let listing of allListings) { %>
            <%- include("_card", { listing }) %>
        <% } %>
    <% } %>
</div>
</div>

<script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("change", () => {
        document.querySelectorAll(".tax-info").forEach((el) => {
            el.style.display = taxSwitch.checked ? "inline" : "none";
        });
    });
</script>