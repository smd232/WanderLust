<% layout("layout/boilerplate") %>

    <section class="hero-section">
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <h1>Find Your Next Adventure</h1>
            <p class="hero-description">
                Discover unique stays, breathtaking places and unforgettable experiences, all in one place.
            </p>

            <!-- search bar -->
            <form action="/listings" method="GET">
                <div class="hero-search">
                    <div class="search-item search-where">
                        <i class="fa-solid fa-location-dot"></i>
                        <input type="text" name="q" placeholder="Where do you want to go?">
                    </div>

                    <div class="search-item">
                        <i class="fa-regular fa-calendar"></i>
                        <input type="date" id="checkin" aria-label="Check in">
                        <span>–</span>
                        <input type="date" id="checkout" aria-label="Check out">
                    </div>

                    <div class="search-item">
    <i class="fa-regular fa-user"></i>
    <select aria-label="Guests">
        <option value="" selected>Guests</option>
        <option>1 guest</option>
        <option>2 guests</option>
        <option>3 guests</option>
        <option>4 guests</option>
        <option>5 guests</option>
        <option>6+ guests</option>
    </select>
</div>
                    <button class="hero-search-btn" aria-label="Search" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- 1. Featured -->
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">Featured packages</p>
                <h2>Handpicked Travel Experiences</h2>
                <p class="sub">Explore our top-rated stays, carefully selected for your perfect getaway.</p>
            </div>
            <a href="/listings" class="view-all">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-1 mb-3">
            <% for (let listing of featured) { %>
                <%- include("_card", { listing }) %>
                    <% } %>
        </div>
    </div>

    <!-- 2. How it works -->
    <section class="container home-section steps">
        <div class="section-head">
            <div>
                <p class="eyebrow">How it works</p>
                <h2>Your trip in three steps</h2>
            </div>
        </div>
        <div class="feature-grid">
            <div class="feature"><span class="step-num">1</span>
                <h3>Search</h3>
                <p>Pick a destination or browse by type of stay.</p>
            </div>
            <div class="feature"><span class="step-num">2</span>
                <h3>Choose</h3>
                <p>Compare photos, prices and reviews.</p>
            </div>
            <div class="feature"><span class="step-num">3</span>
                <h3>Enjoy</h3>
                <p>Pick your place and enjoy the trip.</p>
            </div>
        </div>
    </section>

    <!-- 3. Why band (teal) -->
    <section class="why-band">
        <div class="container">
            <div class="why-head">
                <p class="eyebrow">Why WanderLust</p>
                <h2>Travel made simple</h2>
                <p class="sub">Everything you need to find, compare and choose the perfect stay, in one place.</p>
            </div>
            <div class="feature-grid">
                <div class="feature"><i class="fa-solid fa-hand-holding-heart"></i>
                    <h3>Handpicked stays</h3>
                    <p>Every listing is chosen for its views, comfort and character.</p>
                </div>
                <div class="feature"><i class="fa-solid fa-tags"></i>
                    <h3>Clear prices</h3>
                    <p>See the nightly price up front, with taxes one switch away.</p>
                </div>
                <div class="feature"><i class="fa-solid fa-star"></i>
                    <h3>Real reviews</h3>
                    <p>Read what other travelers say before you decide.</p>
                </div>
            </div>
            <div class="why-action">
                <a href="/listings" class="cta-btn">Explore all stays <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </div>
    </section>

    <br><br><br>

    <!-- 4. Browse by type -->
    <section class="container home-section">
        <div class="section-head">
            <div>
                <p class="eyebrow">Browse by type</p>
                <h2>Find your kind of stay</h2>
            </div>
        </div>
        <div class="cat-grid">
            <a href="/listings?category=beach" class="cat-tile"><i
                    class="fa-solid fa-umbrella-beach"></i><span>Beach</span></a>
            <a href="/listings?category=mountains" class="cat-tile"><i
                    class="fa-solid fa-mountain"></i><span>Mountains</span></a>
            <a href="/listings?category=camping" class="cat-tile"><i
                    class="fa-solid fa-tents"></i><span>Camping</span></a>
            <a href="/listings?category=pools" class="cat-tile"><i
                    class="fa-solid fa-person-swimming"></i><span>Pools</span></a>
            <a href="/listings?category=iconic-cities" class="cat-tile"><i
                    class="fa-solid fa-mountain-city"></i><span>Iconic cities</span></a>
            <a href="/listings?category=farms" class="cat-tile"><i class="fa-solid fa-cow"></i><span>Farms</span></a>
        </div>
    </section>

    <br><br><br>

    <!-- 5. Guest favorites -->
    <% if (favorites.length) { %>
        <section class="container home-section favorites">
            <div class="section-head">
                <div>
                    <p class="eyebrow">Most loved</p>
                    <h2>Guest favorites</h2>
                </div>

            </div>
            <div class="guest-favorite-card">
                <i class="fa-solid fa-award gf-icon"></i>
                <div class="gf-text">
                    <p class="gf-title">Guest favorite</p>
                    <p class="gf-subtitle">The most loved stays on WanderLust, chosen by travelers.</p>
                </div>
                <div class="gf-divider"></div>
                <div class="gf-rating">
                    <span class="gf-score">5.0</span>
                    <i class="fa-solid fa-star gf-icon"></i>
                    <i class="fa-solid fa-star gf-icon"></i>
                    <i class="fa-solid fa-star gf-icon"></i>
                    <i class="fa-solid fa-star gf-icon"></i>
                    <i class="fa-solid fa-star gf-icon"></i>
                </div>
            </div>
            <div class="row row-cols-lg-4 row-cols-md-2 row-cols-1 mb-3">
                <% for (let listing of favorites) { %>
                    <%- include("_card", { listing }) %>
                        <% } %>
            </div>
        </section>
        <% } %>

            <script>
                const targets = document.querySelectorAll(
                    ".section-head, .listing-link, .feature, .cat-tile, .guest-favorite-card"
                );

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        const el = entry.target;
                        el.classList.add("show");
                        observer.unobserve(el);
                        // clean up afterwards so hover effects stay fast
                        setTimeout(() => {
                            el.classList.remove("reveal", "show");
                            el.style.transitionDelay = "";
                        }, 1200);
                    });
                }, { threshold: 0.15 });

                targets.forEach((el) => {
                    const index = Array.from(el.parentElement.children).indexOf(el);
                    el.classList.add("reveal");
                    el.style.transitionDelay = `${Math.min(index, 5) * 90}ms`;
                    observer.observe(el);
                });

                const checkin = document.getElementById("checkin");
                const checkout = document.getElementById("checkout");
                const today = new Date().toISOString().split("T")[0];
                checkin.min = checkout.min = today;
                checkin.addEventListener("change", () => { checkout.min = checkin.value || today; });
            </script>